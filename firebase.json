{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      ".firebaserc",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "notas/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/html/index.html",
        "type": 301
      }
    ]
  }
}
